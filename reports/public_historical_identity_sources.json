  "source_interpretations": [
    {
      "scope": "Public quarterly ownership XML extracts beginning in 2006. As-filed data may contain filing and extraction errors. Original submissions remain the source for case verification.",
      "source_id": "insider_landing"
    },
    {
      "scope": "SUBMISSION supplies issuer CIK and reported ticker; REPORTINGOWNER separately describes reporter identity. The data supplies filing/report dates, not a historical effective-interval crosswalk or known_at timestamp.",
      "source_id": "insider_dictionary"
    },
    {
      "scope": "Section 3.3.1 gives distinct SUBJECT-COMPANY, FILED-BY, ISSUER and REPORTING-OWNER nests, plus correction-related date fields. Entity role must be established within the same submission.",
      "source_id": "pds_dictionary"
    },
    {
      "scope": "SEC permits post-acceptance corrections/deletions. Later corrections may affect current documents/indexes; current source retrieval is not automatically a preserved original publication version.",
      "source_id": "edgar_access_guide"
    },
    {
      "scope": "Acceptance, filing, and last-change dates have different meanings. The SEC states that submission timestamps do not identify first availability on sec.gov.",
      "source_id": "sec_timestamp_faq"
    }
  ],
